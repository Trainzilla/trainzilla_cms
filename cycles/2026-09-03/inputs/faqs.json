            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Our system automatically retries failed payments after 24 hours, sends payment reminder notifications to clients, provides alternative payment methods, and notifies you of any issues. You can also manually process payments or adjust due dates as needed.",

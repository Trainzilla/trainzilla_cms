# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Create it per environment: one for local dev, a separate one on the server.

# --- MongoDB ---------------------------------------------------------------
# Local dev:  mongodb://127.0.0.1:27017/trainzilla_cms
# Server:     the shared cluster / mongo, with its OWN database name, e.g.
#             mongodb+srv://USER:PASS@your-cluster/trainzilla_cms?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/trainzilla_cms

# --- Payload ------------------------------------------------------------------
# A long random string. Generate once with `openssl rand -hex 32` and NEVER
# change it after go-live (it invalidates every session and API key).
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Local dev:  http://localhost:3000
# Server:     https://cms.trainzilla.in
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# --- Server only -----------------------------------------------------------
# Port `next start` listens on (nginx reverse-proxies to it). Local dev omits this.
# PORT=3001

# Netlify build hook for the marketing site — publishing content POSTs this to
# redeploy trainzilla.in. Get it from Netlify -> Site settings -> Build hooks.
# Leave unset in local dev (the hook is a no-op without it).
# NETLIFY_BUILD_HOOK_URL=https://api.netlify.com/build_hooks/xxxxxxxxxxxx

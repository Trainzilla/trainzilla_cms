    "question": "How do I add a new client to my dashboard?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "To add a new client: 1) Go to Client Management in your dashboard, 2) Click \"Add New Client\", 3) Enter their basic information and goals, 4) Complete the fitness assessment questionnaire, 5) Set their subscription plan and payment method. You can also invite clients to join via email or WhatsApp.",
                "version": 1
              }
            ]
          }
        ]
      }

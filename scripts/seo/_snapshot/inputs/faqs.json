  {
    "createdAt": "2026-09-02T15:43:03.649Z",
    "updatedAt": "2026-09-09T13:49:51.451Z",
    "question": "Can I offer EMI or installment plans to clients?",
    "answer": {
      "root": {
        "type": "root",
        "children": [
          {
            "type": "paragraph",
            "version": 1,
            "format": "",
            "indent": 0,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "You can bill clients monthly on a recurring plan, so a longer package is spread across regular payments instead of one upfront charge. Trainzilla does not offer formal bank EMI, but month-to-month billing covers most pay-as-you-go cases and the system handles the recurring charge and reminders.",
                "version": 1
              }
            ]
          }
        ],

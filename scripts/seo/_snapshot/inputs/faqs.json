  {
    "createdAt": "2026-09-02T15:43:02.882Z",
    "updatedAt": "2026-09-06T11:32:07.199Z",
    "question": "How do I track client progress effectively?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Progress lives in three places that connect: scheduled check-ins (measurements, photos and the questions you set, in one queue), habit tracking (a daily-target compliance percentage over any date range), and session attendance. The AI can read all of it and flag clients who have stalled or gone quiet before your next call.",
                "version": 1
              }
            ]
          }
        ]
      }
    },

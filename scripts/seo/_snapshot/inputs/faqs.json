  },
  {
    "createdAt": "2026-09-02T15:43:02.690Z",
    "updatedAt": "2026-09-09T13:49:50.051Z",
    "question": "Can I manage family members or couples together?",
    "answer": {
      "root": {
        "type": "root",
        "children": [
          {
            "type": "paragraph",
            "version": 1,
            "format": "",
            "indent": 0,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "You add each person as their own client, with their own plan, check-ins and progress. There is no shared household account — training a couple or family just means adding two or three clients and, if you like, building their plans from the same template so they stay in sync.",
                "version": 1
              }
            ]
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "version": 1
      }
    },

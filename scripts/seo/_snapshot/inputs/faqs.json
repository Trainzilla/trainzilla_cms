    "id": "6a9d4f371ffc75efe9960ab5"
  },
  {
    "createdAt": "2026-09-06T10:26:41.848Z",
    "updatedAt": "2026-09-06T11:32:05.894Z",
    "question": "How much does Trainzilla cost?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Free Launch is ₹0 forever — a coach profile, one paid offer, an invite link and a marketplace listing. Coach Pro is ₹499/month and adds the client app, workout and nutrition tools, check-ins, habits, payments, messaging and analytics. Gyms use seat-based plans starting at ₹1,499/month for up to 5 coaches. You can start on Free Launch without a card.",
                "version": 1
              }
            ]
          }
        ]
      }
    },

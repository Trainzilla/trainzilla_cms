  {
    "createdAt": "2026-09-02T15:43:03.844Z",
    "updatedAt": "2026-09-09T13:49:50.895Z",
    "question": "What happens if a client's payment fails?",
    "answer": {
      "root": {
        "type": "root",
        "children": [
          {
            "type": "paragraph",
            "version": 1,
            "format": "",
            "indent": 0,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "You are notified when a client's payment fails. Recurring payments retry automatically through the payment provider and the client is prompted to update or complete payment. You can also record a payment manually or change the due date from the client's billing page.",
                "version": 1
              }
            ]
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "version": 1
      }

[
  {
    "createdAt": "2026-09-06T11:32:08.690Z",
    "updatedAt": "2026-09-06T11:32:08.690Z",
    "question": "What happens when I outgrow the Free plan?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Free Launch has no time limit — you move to Coach Pro when you want the client app, check-ins, habits, multiple offers and analytics, not because a trial expired. Upgrading is one click and keeps everything you've already set up. Gyms with several coaches move to seat-based plans starting at ₹1,499/month for 5 coaches.",
                "version": 1
              }
            ]
          }
        ]
      }
    },
    "category": "payments-billing",
    "order": 26,
    "featuredOnPages": [
      "faq"
    ],
    "_status": "published",
    "id": "6a9d4f381ffc75efe9960ad1"
  },
  {
    "createdAt": "2026-09-06T11:32:08.497Z",
    "updatedAt": "2026-09-06T11:32:08.497Z",
    "question": "Is there a contract or lock-in?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "No contract. Coach Pro is month-to-month — cancel any time and you drop back to Free Launch. You can export your client data (contacts, progress history, workout logs, payment records) as a spreadsheet whenever you want, so nothing is trapped.",
                "version": 1
              }
            ]
          }
        ]
      }
    },
    "category": "payments-billing",
    "order": 24,
    "featuredOnPages": [
      "faq"
    ],
    "_status": "published",
    "id": "6a9d4f381ffc75efe9960aca"
  },
  {
    "createdAt": "2026-09-06T11:32:08.296Z",
    "updatedAt": "2026-09-06T11:32:08.296Z",
    "question": "How do I move my existing clients onto Trainzilla?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Add each client from your dashboard with their basic details and goals, then send them an invite by email or WhatsApp to install the client app. You rebuild their current plan once from a template (or let the AI draft it from their profile), and from then on check-ins, habits and progress all live in one place. Most coaches move their roster over a week or two, a few clients at a time.",
                "version": 1
              }
            ]
          }
        ]
      }
    },
    "category": "client-management",
    "order": 22,
    "featuredOnPages": [
      "faq"
    ],
    "_status": "published",
    "id": "6a9d4f381ffc75efe9960ac3"
  },
  {
    "createdAt": "2026-09-06T11:32:08.106Z",
    "updatedAt": "2026-09-06T11:32:08.106Z",
    "question": "Can I try Trainzilla with real clients before I pay?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "Yes. Free Launch is ₹0 forever and lets you run a profile, one paid offer and an invite link — enough to onboard a first client and see how it works. Coach Pro (₹499/month) unlocks the client app, check-ins, habits and the full toolset when you're ready; there's no card required to start and no trial clock.",
                "version": 1
              }
            ]
          }
        ]
      }
    },

  {
    "createdAt": "2026-09-02T15:43:02.290Z",
    "updatedAt": "2026-09-06T11:32:06.673Z",
    "question": "How does the AI workout generator work?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "You give the AI the client's goal, experience, available equipment, time per session and any injuries, and it builds a structured plan from Trainzilla's exercise catalogue — real movements with demo content, not free text. You review it, change anything you want, and publish it to the client's app. As check-ins come in, the AI can propose updates to keep the plan current — always for your approval, never on its own.",
                "version": 1
              }
            ]
          }
        ]
      }
    },

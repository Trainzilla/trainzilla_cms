  },
  {
    "createdAt": "2026-09-06T11:32:07.906Z",
    "updatedAt": "2026-09-06T11:32:07.906Z",
    "question": "Does Trainzilla take a cut of my client payments?",
    "answer": {
      "root": {
        "type": "root",
        "format": "",
        "indent": 0,
        "version": 1,
        "direction": "ltr",
        "children": [
          {
            "type": "paragraph",
            "format": "",
            "indent": 0,
            "version": 1,
            "direction": "ltr",
            "textFormat": 0,
            "children": [
              {
                "type": "text",
                "format": 0,
                "style": "",
                "mode": "normal",
                "detail": 0,
                "text": "No. Your clients pay you directly through your own payment setup — Trainzilla doesn't sit between you and your revenue or take a percentage. You pay a flat monthly platform fee (₹0 on Free Launch, ₹499 on Coach Pro) and keep 100% of what your clients pay you.",
                "version": 1
              }
            ]
          }
        ]
      }
    },
    "category": "payments-billing",

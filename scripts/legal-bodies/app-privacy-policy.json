          {
            "type": "text",
            "format": 0,
            "style": "",
            "mode": "normal",
            "detail": 0,
            "text": "This Privacy Policy describes how the Trainzilla Client App (\"we\", \"us\", or \"our\") collects, uses, and protects your information. Our app is designed to help you communicate with your fitness coaches.",
            "version": 1
          }
        ]
      },
      {

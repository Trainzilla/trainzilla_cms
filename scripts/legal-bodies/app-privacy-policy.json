        "children": [
          {
            "type": "text",
            "format": 0,
            "style": "",
            "mode": "normal",
            "detail": 0,
            "text": "To facilitate professional fitness coaching, our app requires access to your device's Camera.",
            "version": 1
          }
        ]
      },
      {
        "type": "heading",
        "tag": "h3",
        "format": "",

          {
            "type": "text",
            "format": 0,
            "style": "",
            "mode": "normal",
            "detail": 0,
            "text": "We use camera access solely to allow you to take and share \"Progress Photos\" or form-check images directly with your assigned coach.",
            "version": 1
          }
        ]
      },
      {
        "type": "heading",
        "tag": "h3",
